{
  "name": "mockmind",
  "version": "0.1.0",
  "description": "A TypeScript mock server for OpenAI-compatible and LLM provider APIs",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mockmind": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs"
  ],
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsup --config tsup.config.ts && tsc -p tsconfig.build.json && node scripts/copy-console-assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "latest",
    "@mockmind/shared": "file:../../packages/shared",
    "better-sqlite3": "^12.9.0",
    "commander": "latest",
    "fastify": "latest",
    "yaml": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "latest",
    "tsup": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "latest"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "MockMind contributors",
  "homepage": "https://github.com/Devliang24/mockmind#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Devliang24/mockmind.git"
  },
  "bugs": {
    "url": "https://github.com/Devliang24/mockmind/issues"
  },
  "keywords": [
    "llm",
    "mock-server",
    "openai",
    "anthropic",
    "gemini",
    "dashscope",
    "typescript"
  ]
}
